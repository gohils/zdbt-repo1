# Copy to .env and fill in:  cp .env.example .env
# Every script, agent and dbt command in this repo reads these values.

# --- Google Cloud ---------------------------------------------------------
GOOGLE_CLOUD_PROJECT=your-sandbox-project-id
# Location used for Gemini calls (Vertex AI). Newer Gemini models are often
# served from the "global" location; use a region such as us-central1 if your
# chosen model requires it.
GOOGLE_CLOUD_LOCATION=global
# Use Vertex AI (not an API key) for Gemini
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# --- Models ---------------------------------------------------------------
# Pick the newest Gemini Flash model approved in your organisation and check
# it in Vertex AI Model Garden. gemini-2.5-flash is scheduled for retirement
# (not before 16 Oct 2026), so prefer a newer one if it is available to you.
AGENT_MODEL=gemini-3.5-flash
# Embedding endpoint used by the BigQuery remote model
EMBEDDING_ENDPOINT=text-embedding-005

# --- BigQuery -------------------------------------------------------------
BQ_LOCATION=US
BQ_SOURCE_DATASET=demo_source
BQ_VAULT_DATASET=demo_vault
BQ_MART_DATASET=demo_mart
BQ_CONTEXT_DATASET=demo_context
BQ_SANDBOX_DATASET=demo_sandbox
BQ_SANDBOX_VAULT_DATASET=demo_sandbox_vault
# Cloud resource connection used by the embedding remote model
BQ_CONNECTION=vertex_conn
# Hard cap per agent query (1 GB). Must be >= 10485760.
MAX_BYTES_BILLED=1073741824

# --- Graph ----------------------------------------------------------------
# gql : BigQuery Graph (needs an Enterprise / Enterprise Plus reservation)
# sql : recursive SQL fallback that works on on-demand projects
GRAPH_MODE=sql
GRAPH_NAME=lineage_graph

# --- Synthetic data agent ---------------------------------------------------
# Where the agent saves generator SQL scripts (local runs)
GENERATED_DIR=generated
